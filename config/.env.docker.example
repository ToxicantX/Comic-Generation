# Comic pipeline Docker config
# Copy to config\.env.docker for Docker Compose mode.

COMIC_PIPELINE_WORKSPACE=/app
COMIC_PIPELINE_COMFY_ROOT=/comfyui
COMIC_PIPELINE_COMFY_URL=http://host.docker.internal:8188
COMIC_PIPELINE_OUTPUT_ROOT=/comfyui/output/ComicPipeline
COMIC_PIPELINE_COMFY_OUTPUT_ROOT=/comfyui/output
COMIC_PIPELINE_NOVEL_PATH=
COMIC_PIPELINE_TEXT_ENV_PATH=/app/config/text.env
COMIC_PIPELINE_IMAGE_ENV_PATH=/app/config/image.env
COMIC_PIPELINE_DATABASE_URL=postgresql://comic_pipeline:comic_pipeline@postgres:5432/comic_pipeline
COMIC_PIPELINE_TEXT_MODEL=gpt-4.1-mini
COMIC_PIPELINE_TEXT_MODEL_TIMEOUT=300
COMIC_PIPELINE_TEXT_MODEL_STREAM=true
COMIC_PIPELINE_IMAGE_MODEL=gpt-image-2
COMIC_PIPELINE_IMAGE_QUALITY=auto
COMIC_PIPELINE_PYTHON_PATH=python
COMIC_PIPELINE_DEFAULT_PAGES=8
COMIC_PIPELINE_ENCODING=gb18030
COMIC_PIPELINE_ACTIVE_PROJECT=sou_shen_ji
